# Copy this file to .env (next to vlcstreamkeeper.py) and fill in your values.
# Never commit .env: the stream URL usually contains the camera's credentials.

# Required: your camera's RTSP address.
STREAM_URL=rtsp://YOUR_CAMERA_IP:7447/YOUR_STREAM_TOKEN

# Optional settings. The values shown are the defaults.
# Seconds between checks on VLC.
POLL_TIME=2
# Seconds before the first relaunch retry. Doubles after each failed
# relaunch, up to MAX_BACKOFF.
COOLDOWN_TIME=10
# Longest wait between relaunches when the camera keeps failing, in seconds.
MAX_BACKOFF=300
# Seconds VLC may report "Playing" without its clock moving before the
# picture is treated as frozen.
STALL_TIMEOUT=30
# Seconds to let a freshly launched VLC connect before judging it.
STARTUP_GRACE=20
# VLC's network buffer, in milliseconds.
NETWORK_CACHE=3000
# Player to launch: cvlc (no VLC window or menus, recommended) or vlc.
VLC_BINARY=cvlc
# Video output module. xcb_x11 matches the original setup; leave it empty to
# let VLC choose, which may work better on a Wayland desktop.
VLC_VOUT=xcb_x11
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
